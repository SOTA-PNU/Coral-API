diff --git a/.bazelrc b/.bazelrc
index 73750e7d..27d9bd03 100644
--- a/.bazelrc
+++ b/.bazelrc
@@ -130,3 +130,11 @@ build --output_filter="^//(?!(third_party)(/|:|$))"
 
 # Import user config, if it exists (gitignored).
 try-import %workspace%/.bazelrc.user
+
+# --- npusim: MPACT-CoralNPU behavioral simulator (Coral docs //sim:coralnpu_v2_sim) ---
+# The CLI binary lives in the external @coralnpu_mpact repo and is built from this
+# (coralnpu_hw) workspace. MPACT sources need clang (they use -ffp-model=strict) and
+# the generated decoders #include "external/..." paths, so add the execroot root (-I.).
+#   Usage: bazel run --config=npusim //sim:coralnpu_v2_sim -- <program.elf>
+build:npusim --platforms=//toolchain/host_clang:host_clang_platform
+build:npusim --copt=-I.
