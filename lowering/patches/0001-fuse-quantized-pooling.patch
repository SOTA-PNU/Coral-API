+
 // A QCommutingOp is an Op satisfying:
 // 1. Has at most one tensor operand at index 0
 // 2. Has a single output, which is a tensor
@@ -110,6 +121,16 @@ public:
           chain.MPTQTOpd = MPTQTOp.getOperand(0);
           chain.scale = MPTQTOp.getOperand(1);
